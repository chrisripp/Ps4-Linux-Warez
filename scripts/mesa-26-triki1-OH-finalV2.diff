          identify_chip2(KALINDI, KABINI);
          identify_chip2(GODAVARI, KABINI);
          break;
@@ -1242,6 +1246,27 @@
    info->min_good_cu_per_sa =
       (info->num_cu / (info->num_se * info->max_sa_per_se * cu_group)) * cu_group;
 
+   /* PS4 Liverpool/Gladius : le kernel PS4 ne remonte pas correctement
+    * device_info->cu_bitmap[][], donc num_cu calcule ci-dessus est faux.
+    * On force les vraies valeurs silicon pour que ACO repartisse
+    * correctement les wavefronts sur les CU disponibles.
+    *
+    * Topologie PS4 documentee (Sony/AMD) : pas de subdivision en
+    * shader arrays comme un GCN standard. CU distribues uniformement
+    * par shader engine, 1 SA/SE effectif :
+    *   Liverpool (PS4)     : 18 CU / 2 SE = 9 CU/SE
+    *   Gladius   (PS4 Pro) : 36 CU / 4 SE = 9 CU/SE
+    * → max_good_cu_per_sa = 9 dans les deux cas (coherent). */
+   if (info->family == CHIP_LIVERPOOL) {
+      info->num_cu             = 18;
+      info->max_good_cu_per_sa = 9;
+      info->min_good_cu_per_sa = 9;
+   } else if (info->family == CHIP_GLADIUS) {
+      info->num_cu             = 36;
+      info->max_good_cu_per_sa = 9;
+      info->min_good_cu_per_sa = 9;
+   }
+
    info->gfx_ib_pad_with_type2 = info->gfx_level == GFX6;
 
    if (info->gfx_level >= GFX11 && info->gfx_level < GFX12) {
@@ -1463,6 +1488,18 @@
       }
    }
 
+   /* PS4 Liverpool/Gladius : le kernel PS4 ne remonte souvent qu'une
+    * ring compute/sdma tronquee, alors que Sea Islands dispose de
+    * 8 pipes ACE et 2 moteurs SDMA. Sans cette correction, RADV pense
+    * qu'il n'y a presque pas de queues compute et n'utilise jamais
+    * l'async compute -> perte de perf Vulkan moderne (Heaven/UE4). */
+   if (info->family == CHIP_LIVERPOOL || info->family == CHIP_GLADIUS) {
+      if (info->ip[AMD_IP_COMPUTE].num_queues < 8)
+         info->ip[AMD_IP_COMPUTE].num_queues = 8;
+      if (info->ip[AMD_IP_SDMA].num_queues < 2)
+         info->ip[AMD_IP_SDMA].num_queues = 2;
+   }
+
    /* Only require gfx or compute. */
    if (!info->ip[AMD_IP_GFX].num_queues && !info->ip[AMD_IP_COMPUTE].num_queues) {
       fprintf(stderr, "amdgpu: failed to find gfx or compute.\n");
@@ -2226,6 +2263,8 @@
    case CHIP_TAHITI:
    case CHIP_PITCAIRN:
    case CHIP_VERDE:
+   case CHIP_LIVERPOOL:
+   case CHIP_GLADIUS:
    case CHIP_BONAIRE:
    case CHIP_HAWAII:
    case CHIP_TONGA:
@@ -2296,6 +2335,23 @@
       raster_config = 0x3a00161a;
       raster_config_1 = 0x0000002e;
       break;
+   case CHIP_LIVERPOOL:
+      /* PS4 fat/slim - Liverpool semi-custom GFX7
+       * 2 SE, 4 SA/SE, 2 RB/SA - no display engine
+       * Values extracted from PS4 hardware register dumps.
+       */
+      raster_config   = 0x2a00161a;
+      raster_config_1 = 0x00000000;
+      break;
+   case CHIP_GLADIUS:
+      /* PS4 Pro - Gladius semi-custom GFX7
+       * 4 SE, 4 SA/SE, 2 RB/SA - no display engine
+       * raster_config_1 reflects the 4-SE layout like Hawaii.
+       * Values extracted from PS4 Pro hardware register dumps.
+       */
+      raster_config   = 0x2a00161a;
+      raster_config_1 = 0x0000002e;
+      break;
    default:
       fprintf(stderr, "ac: Unknown GPU, using 0 for raster_config\n");
       raster_config = 0x00000000;

