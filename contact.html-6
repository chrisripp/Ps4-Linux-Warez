						<a href="#" title="Telegram"><i class="fa fa-telegram"></i></a>
						<a href="#" title="GitHub"><i class="fa fa-github"></i></a>
						<a href="#" title="Discord"><i class="fa fa-discord"></i></a>
					</div>
				</div>
				<div class="col-lg-8">
					<div class="contact-form-warp">
						<h4 class="comment-title">Laisser un message</h4>
						<form class="comment-form" action="contact.php" method="post">
							<div class="row">
								<div class="col-md-6">
									<input type="text" name="nom" placeholder="Nom">
								</div>
								<div class="col-md-6">
									<input type="email" name="email" placeholder="E-mail">
								</div>
								<div class="col-lg-12">
									<input type="text" name="sujet" placeholder="Sujet">
									<textarea name="message" placeholder="Message"></textarea>
									<button class="site-btn btn-sm" type="submit">Envoyer</button>
								</div>
							</div>
						</form>
					</div>
				</div>
			</div>
